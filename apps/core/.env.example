# Copy to .env.local for local work. Real values live in Vercel, never in the repo.

# Neon Postgres. The Vercel Neon integration sets this for you.
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The one email allowed to log in. Seeded into the users table as the owner.
OWNER_EMAIL=

# Agent gateway. The agent refuses to run until all three are set.
# AGENT_MODEL is the model id, e.g. claude-sonnet-5-5. Swap it without a code change.
AGENT_MODEL=
ANTHROPIC_API_KEY=
# Daily spend ceiling in USD, counted from midnight South African time.
# Past it the agent answers but takes no actions; past twice it, it stops.
AGENT_DAILY_CEILING_USD=
