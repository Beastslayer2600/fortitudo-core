# Copy to .env.local for local work. Real values live in Vercel, never in the repo.

# Neon Postgres. The Vercel Neon integration sets this for you.
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The one email allowed to log in. Seeded into the users table as the owner.
OWNER_EMAIL=

# Agent gateway. The model is your own, served by Ollama on your PC through the
# token-checked proxy in tools/local-model (see tools/local-model/SETUP.md).
# The agent refuses to run until all three model settings are set.
AGENT_MODEL=            # e.g. qwen3:4b
AGENT_MODEL_URL=        # e.g. https://desktop-43nsst2.your-tailnet.ts.net
AGENT_MODEL_TOKEN=      # the same secret as token.txt on the PC
# Requests per day (from midnight South African time). Past it the agent
# answers but takes no actions; past twice it, it stops. Default 100.
AGENT_DAILY_REQUEST_CAP=
